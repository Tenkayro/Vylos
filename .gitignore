# =============================================================================
# Vylos Family Control — .gitignore
# =============================================================================

# Compiled Executables & Windows Installer Artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.msi
*.wixobj
*.wixpdb
*.cab
*.syso

# Build & Release Output Directories
/dist/
/build/
/bin/
/out/
/frontend/dist/
/frontend/.vite/
latest.json
latest.yml

# Node.js Dependencies & Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Go Build, Test & Coverage Artifacts
*.test
*.out
coverage.txt
coverage.html
go.work
go.work.sum

# Local SQLite Databases, WAL & Encrypted Keystores
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
/keys/
*.key
*.pem
*.crt

# Environment & Local Secrets
.env
.env.*
!.env.example

# IDE, Editor & OS Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
