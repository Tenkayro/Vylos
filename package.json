{
  "name": "vylos",
  "version": "1.1.2",
  "private": true,
  "description": "Vylos Family Control — Complete Open-Source Local Parental Control Application",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tenkayro/Vylos.git"
  },
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --ui-port 41800",
    "build": "node scripts/build.mjs",
    "build:frontend": "node frontend/scripts/build.mjs",
    "build:backend": "go build -ldflags=\"-s -w\" -o Vylos.exe .",
    "build:msi": "node scripts/build-msi.mjs",
    "release": "node scripts/release.mjs",
    "web": "node scripts/web.mjs",
    "web:preview": "node scripts/web.mjs --preview",
    "test": "node scripts/test.mjs",
    "test:frontend": "node --test frontend/scripts/test.mjs",
    "test:go": "go test -v ./..."
  },
  "devDependencies": {
    "@clack/prompts": "^1.0.1"
  }
}
