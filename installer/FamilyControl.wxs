<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="FamilyControl"
    Language="1033"
    Version="1.0.0.0"
    Manufacturer="FamilyControl Open Source Project"
    UpgradeCode="94A8E4B5-3E1F-4B5C-8812-7E5A9104F11A">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Description="FamilyControl — Open-Source Local Parental Control for Windows 10/11"
      Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="FamilyControl Application and Service" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="FamilyControl" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="FamilyControl" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutableAndService" Guid="8E41A7C3-5092-4847-A1E9-30E522B409B1" Win64="yes">
        <File Id="FamilyControlExe" Source="..\FamilyControl.exe" KeyPath="yes" />

        <ServiceInstall
          Id="FamilyControlServiceInstaller"
          Type="ownProcess"
          Vital="yes"
          Name="FamilyControlService"
          DisplayName="FamilyControl Parental Control Service"
          Description="Enforces local FamilyControl rules and synchronizes with the Parent computer over LAN."
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Arguments="--service" />

        <ServiceControl
          Id="StartFamilyControlService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Name="FamilyControlService"
          Wait="yes" />
      </Component>
    </ComponentGroup>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="D1C92F14-7A22-4B08-9B3C-61F82301A94E">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="FamilyControl"
          Description="Open FamilyControl Dashboard or Child Status"
          Target="[INSTALLFOLDER]FamilyControl.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\FamilyControl" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
